# Averiqo app URL. Onboarding and login hand off to $NEXT_PUBLIC_APP_URL/dashboard.
NEXT_PUBLIC_APP_URL=
# Where "View Live Demo" goes. Defaults to the built-in /demo page.
NEXT_PUBLIC_DEMO_URL=
# Public site URL, used for Stripe return URLs.
NEXT_PUBLIC_SITE_URL=

# Averiqo backend. When set, signup/login/company/onboarding are forwarded to:
#   POST /auth/signup, /auth/login, /companies, /onboarding/complete
# When empty the site runs in demo mode (flow works end to end, nothing is saved).
AVERIQO_API_URL=
AVERIQO_API_KEY=

# Stripe. When set, checkout opens a real Stripe Checkout session.
STRIPE_SECRET_KEY=

# Optional: JSON endpoint returning the same shape as config/pricing.json,
# so pricing can be managed from Averiqo admin/settings.
PRICING_API_URL=
