# Server-side only (used by the /api proxy route; never exposed to the browser)
QUANT_API_URL=http://127.0.0.1:8000
QUANT_API_TOKEN=
# Optional: browser WebSocket for live bars (default: ws://<this host>:8000/ws, with automatic
# fallback to HTTP polling through the /api proxy if it can't be reached)
# NEXT_PUBLIC_QUANT_WS_URL=ws://localhost:8000/ws
