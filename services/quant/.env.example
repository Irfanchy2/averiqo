# Copy to .env (never commit real values).
TP_ENV=development
TP_DATABASE_URL=sqlite:///./tradepilot.db
# PostgreSQL needs: pip install -r requirements-postgres.txt
# TP_DATABASE_URL=postgresql+psycopg://tradepilot:tradepilot@localhost:5432/tradepilot
# TP_REDIS_URL=redis://localhost:6379/0
TP_MARKET_DATA_PROVIDER=simulated        # simulated | binance_public
TP_API_TOKEN=                            # set in any shared/deployed environment
TP_CORS_ORIGINS=http://localhost:3000
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TP_CREDENTIALS_ENCRYPTION_KEY=
TP_LIVE_TRADING_ENABLED=false            # hard server-side gate; keep false
TP_PAPER_STARTING_BALANCE=10000
